# node
node_modules

# output folders for 'just build'
/out
/.cache/

# personal devcontainer settings and matching lock file
/.devcontainer/devcontainer.json
/.devcontainer/devcontainer-lock.json

# default directory for vendored files when using 'jb install/update' to update a jb lockfile
/apps/*/vendor/

# default output file when using 'talosctl gen secrets'
secrets*.yaml

# default output files when using 'talosctl gen config'
controlplane.yaml
worker.yaml
talosconfig

# default output file when using 'talosctl kubeconfig'
kubeconfig
