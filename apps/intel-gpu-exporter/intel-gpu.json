        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "igpu_engines_render_3d_0_wait{instance=~\"$instance\"}",
          "legendFormat": "render_3d_0 wait",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "igpu_engines_render_3d_0_sema{instance=~\"$instance\"}",
          "legendFormat": "render_3d_0 sema",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "igpu_engines_blitter_0_wait{instance=~\"$instance\"}",
          "legendFormat": "blitter_0 wait",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "D",
          "expr": "igpu_engines_blitter_0_sema{instance=~\"$instance\"}",
          "legendFormat": "blitter_0 sema",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "E",
          "expr": "igpu_engines_video_0_wait{instance=~\"$instance\"}",
          "legendFormat": "video_0 wait",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "F",
          "expr": "igpu_engines_video_0_sema{instance=~\"$instance\"}",
          "legendFormat": "video_0 sema",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "igpu_engines_video_enhance_0_wait{instance=~\"$instance\"}",
          "legendFormat": "video_enhance_0 wait",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "igpu_engines_video_enhance_0_sema{instance=~\"$instance\"}",
          "legendFormat": "video_enhance_0 sema",
          "datasource": {
